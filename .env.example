# ==============================================================================
# EVOKE — Environment Configuration (Template)
# Copy this file to .env or .env.local and fill in your API credentials.
# ==============================================================================

# Frontend & Microservice URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
PORT=3000

# LLM APIs (OpenRouter Primary + Groq/Gemini Failover)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Voice Synthesis (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=

# AWS Cloud Settings (Free Tier)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
DYNAMODB_TABLE_NAME=EvokePersonalityVaults
S3_BUCKET_NAME=evoke-personality-vaults-data
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Research Hyperparameters
EPISTEMIC_HUMILITY_THRESHOLD=0.70
